// DEMO / EMULATOR ONLY. These rules are intentionally permissive so the
// recordable local demo (`npm run demo`) works without setup. They are never
// deployed by the demo command - do NOT deploy them to a real project.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
